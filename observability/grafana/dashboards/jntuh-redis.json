        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "expr": "rate(redis_keyspace_hits_total{job=\"redis\"}[$__rate_interval]) / clamp_min(rate(redis_keyspace_hits_total{job=\"redis\"}[$__rate_interval]) + rate(redis_keyspace_misses_total{job=\"redis\"}[$__rate_interval]), 0.000001)",
          "legendFormat": "hit ratio",
          "refId": "A",
          "range": true
