{
  "uid": "jntuh-containers",
  "title": "JNTUH / Docker Containers",
  "schemaVersion": 40,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "tags": [
    "jntuh",
    "docker-compose"
  ],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "title": "CPU usage (cores; 1 = one full core)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_service=~\"$service\", container_label_com_docker_compose_project=~\"$project\", image!=\"\"}[$__rate_interval])",
          "legendFormat": "{{container_label_com_docker_compose_service}} / {{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      }
    },
    {
