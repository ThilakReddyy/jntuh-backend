  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "jntuh-prometheus"
        },
        "query": {
          "query": "label_values(container_last_seen{job=\"cadvisor\",compose_project!=\"\"}, compose_project)",
          "refId": "project"
        },
        "definition": "label_values(container_last_seen{job=\"cadvisor\",compose_project!=\"\"}, compose_project)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "jntuh-prometheus"
        },
        "query": {
          "query": "label_values(container_last_seen{job=\"cadvisor\",compose_project=~\"$project\",compose_service!=\"\"}, compose_service)",
          "refId": "service"
        },
        "definition": "label_values(container_last_seen{job=\"cadvisor\",compose_project=~\"$project\",compose_service!=\"\"}, compose_service)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "title": "Container resources",
      "type": "text",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Select a Compose project and one or more services to inspect **every running container**, including the monitoring stack. CPU is a percentage of one core. Network panels report traffic, errors and dropped packets; the log panel shows stdout/stderr."
      },
      "id": 1
    },
    {
      "title": "CPU by container (% of one core)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "jntuh-prometheus"
      },
      "description": "100% equals one fully used CPU core; a multi-core container can exceed 100%.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "100 * sum by (container) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",compose_project=~\"$project\",compose_service=~\"$service\",image!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{container}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "id": 2
    },
