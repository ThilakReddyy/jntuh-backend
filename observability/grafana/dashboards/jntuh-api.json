  "panels": [
    {
      "title": "Request rate by route/status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "jntuh-prometheus"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (handler, status) (rate(http_requests_total{job=\"fastapi_app\",handler!=\"/metrics\"}[$__rate_interval]))",
          "legendFormat": "{{handler}} {{status}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "id": 1
    },
    {
      "title": "Route p50 / p95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "jntuh-prometheus"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, handler) (rate(http_request_duration_seconds_bucket{job=\"fastapi_app\",handler!=\"/metrics\"}[$__rate_interval])))",
          "legendFormat": "{{handler}} p50",
          "refId": "A",
          "range": true
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket{job=\"fastapi_app\",handler!=\"/metrics\"}[$__rate_interval])))",
          "legendFormat": "{{handler}} p95",
          "refId": "B",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
